# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Local hoặc Prisma Accelerate)
# Ví dụ local: postgresql://user:password@localhost:5432/ownwallet?sslmode=disable
# Ví dụ Prisma Postgres: prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY
DATABASE_URL="postgres://user:password@localhost:5432/ownwallet"


# ─────────────────────────────────────────────────────────────────────────────
# NEXT AUTH v5
# ─────────────────────────────────────────────────────────────────────────────
# Tạo secret ngẫu nhiên bảo mật cao bằng lệnh terminal: openssl rand -base64 32
AUTH_SECRET="your-32-byte-secret-key-here"
NEXTAUTH_SECRET="your-32-byte-secret-key-here"

# URL của app (Production: https://yourdomain.com | Development: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH 2.0 (NextAuth v5)
# Lấy tại Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Danh sách email Whitelist được phép truy cập (phân cách bằng dấu phẩy, để trống nếu cho phép tất cả)
ALLOWED_EMAILS="nhatphanhk102@gmail.com,nhatph102.work@gmail.com,nhatph.hk@gmail.com"


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE GEMINI AI (Dành cho tính năng AI Import sao kê)
# Lấy API key tại: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Giới hạn kích thước file upload (bytes) — mặc định 10MB
AI_MAX_FILE_SIZE_BYTES=10485760

# Số giao dịch tối đa AI có thể trích xuất trong 1 lần phân tích
AI_MAX_TRANSACTIONS_PER_PARSE=500
