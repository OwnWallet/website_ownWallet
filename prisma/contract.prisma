// Prisma 8 Contract Schema (PSL v2)
// Không có generator block hay datasource block — chúng được cấu hình trong prisma.config.ts

// ─────────────────────────────────────────
// ENUMS — Prisma 8 yêu cầu @@type và explicit values
// ─────────────────────────────────────────

enum CategoryType {
  @@type("pg/text@1")
  EXPENSE = "EXPENSE"
  INCOME  = "INCOME"
  INVEST  = "INVEST"
  DEBT    = "DEBT"
  SAVINGS = "SAVINGS"
}

enum TxType {
  @@type("pg/text@1")
  INCOME  = "INCOME"
  EXPENSE = "EXPENSE"
}

enum DebtDir {
  @@type("pg/text@1")
  OWE  = "OWE"   // Tôi nợ người khác
  OWED = "OWED"  // Người khác nợ tôi
}

enum DebtStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  PARTIAL = "PARTIAL"
  PAID    = "PAID"
}

enum InvestAction {
  @@type("pg/text@1")
  BUY  = "BUY"
  SELL = "SELL"
}

enum DebtLogType {
  @@type("pg/text@1")
  INIT    = "INIT"    // Khởi tạo khoản nợ
  TOPUP   = "TOPUP"   // Cộng thêm vào nợ
  PAYMENT = "PAYMENT" // Trả nợ (ghi nhận thanh toán)
  NOTE    = "NOTE"    // Ghi chú thuần tuý
}

enum CashFlowSourceType {
  @@type("pg/text@1")
  SALARY              = "SALARY"              // Tiền lương định kỳ
  INVESTMENT_DIVIDEND = "INVESTMENT_DIVIDEND" // Cổ tức / Lợi tức đầu tư
  RENTAL              = "RENTAL"              // Tiền cho thuê BĐS / tài sản
  INTEREST            = "INTEREST"            // Tiền lãi gửi / trái phiếu
  BUSINESS            = "BUSINESS"            // Lợi nhuận kinh doanh / freelance
  OTHER               = "OTHER"               // Thu nhập định kỳ khác
}

enum CashFlowFrequency {
  @@type("pg/text@1")
  MONTHLY   = "MONTHLY"   // Hàng tháng
  BIWEEKLY  = "BIWEEKLY"  // 2 tuần một lần
  WEEKLY    = "WEEKLY"    // Hàng tuần
  QUARTERLY = "QUARTERLY" // Hàng quý
  YEARLY    = "YEARLY"    // Hàng năm
  ONE_TIME  = "ONE_TIME"  // Một lần trong tương lai
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid(2))
  email     String   @unique
  name      String?
  password  String
  timezone  String   @default("Asia/Ho_Chi_Minh")
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  transactions Transaction[]
  investments  Investment[]
  debts        Debt[]
  goals        Goal[]
  categories   Category[]
  budgets      Budget[]
  wallets      Wallet[]
  cashFlowSources CashFlowSource[]

  @@map("User")
}

model Wallet {
  id            String        @id @default(cuid(2))
  name          String
  accountNumber String?
  bankName      String?
  balance       Decimal       @default("0")
  color         String?       @default("#7c3aed")
  icon          String?       @default("Landmark")
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     temporal.updatedAt()

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  cashFlowSources CashFlowSource[]

  @@index([userId])
  @@map("Wallet")
}

model Category {
  id        String       @id @default(cuid(2))
  name      String
  type      CategoryType
  color     String
  icon      String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  budgets      Budget[]
  cashFlowSources CashFlowSource[]

  @@unique([userId, name])
  @@map("Category")
}

model Transaction {
  id         String   @id @default(cuid(2))
  amount     Decimal
  note        String?
  evidenceUrl String?
  recordedAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt  temporal.updatedAt()
  type       TxType

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, categoryId])
  @@index([userId, type])
  @@index([userId, walletId])
  @@map("Transaction")
}

model Budget {
  id          String  @id @default(cuid(2))
  limitAmount Decimal
  month       Int
  year        Int

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@map("Budget")
}

model Investment {
  id           String   @id @default(cuid(2))
  name         String
  ticker       String?
  assetType    String?
  exchange     String?
  targetPrice  Decimal?
  note         String?
  quantity     Decimal
  buyPrice     Decimal
  currentPrice Decimal?
  boughtAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs InvestLog[]
  cashFlowSources CashFlowSource[]

  @@map("Investment")
}

model InvestLog {
  id         String       @id @default(cuid(2))
  action     InvestAction
  quantity   Decimal
  price      Decimal
  recordedAt DateTime
  createdAt  DateTime     @default(now())

  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@map("InvestLog")
}

model Debt {
  id         String     @id @default(cuid(2))
  person     String
  amount     Decimal
  paidAmount Decimal    @default("0")
  direction  DebtDir
  status     DebtStatus @default(PENDING)
  priority   String     @default("NORMAL")
  dueDate    DateTime?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  temporal.updatedAt()

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs   DebtLog[]

  @@index([userId, status])
  @@index([userId, direction])
  @@map("Debt")
}

model DebtLog {
  id         String      @id @default(cuid(2))
  type       DebtLogType
  amount     Decimal?    // Số tiền liên quan (TOPUP / PAYMENT)
  note       String?     // Mô tả bổ sung
  txId       String?     // ID Transaction liên kết (nếu có)
  recordedAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([debtId, recordedAt])
  @@map("DebtLog")
}

model Goal {
  id           String    @id @default(cuid(2))
  name         String
  targetAmount Decimal
  savedAmount  Decimal   @default("0")
  deadline     DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    temporal.updatedAt()

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Transaction[]

  @@map("Goal")
}

model CashFlowSource {
  id               String             @id @default(cuid(2))
  name             String
  amount           Decimal
  type             CashFlowSourceType @default(SALARY)
  frequency        CashFlowFrequency  @default(MONTHLY)
  dayOfMonth       Int?               // Ngày nhận trong tháng (1 - 31) nếu MONTHLY
  nextExpectedDate DateTime           // Ngày dự kiến nhận tiền tiếp theo
  isActive         Boolean            @default(true)
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        temporal.updatedAt()

  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId         String?
  wallet           Wallet?            @relation(fields: [walletId], references: [id])

  categoryId       String?
  category         Category?          @relation(fields: [categoryId], references: [id])

  investmentId     String?
  investment       Investment?        @relation(fields: [investmentId], references: [id])

  @@index([userId, isActive])
  @@index([userId, nextExpectedDate])
  @@map("CashFlowSource")
}

